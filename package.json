{
	"name": "canvas-smooth-linker",
	"version": "1.3.2",
	"description": "Obsidian Canvas 内部链接的 PPT 式平滑聚焦插件",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "node _test/build.mjs && node _test/harness.cjs",
		"check": "node scripts/check-plugin.mjs",
		"version:set": "node scripts/set-version.mjs",
		"release": "node scripts/build-release.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"canvas"
	],
	"license": "MIT",
	"devDependencies": {
		"esbuild": "^0.25.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.6.0"
	}
}
